{
  "info": {
    "_postman_id": "lab3-rest-api-vinod-kumar",
    "name": "Lab 3: REST API & Query Parameters - Vinod Kumar",
    "description": "Comprehensive Postman test collection for Lab 3 (REST API, Query Parameters, Validation & Debugging) - Student: VINOD KUMAR (252U1R1184), Faculty: Joel Prashanth D",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. GET / - Root Welcome Info",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        }
      }
    },
    {
      "name": "2. GET /books - All Books (Default)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        }
      }
    },
    {
      "name": "3. GET /books?search_q=Python - Title Search",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?search_q=Python",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            { "key": "search_q", "value": "Python" }
          ]
        }
      }
    },
    {
      "name": "4. GET /books?order_by=price&order=DESC - Sort Descending",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?order_by=price&order=DESC",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            { "key": "order_by", "value": "price" },
            { "key": "order", "value": "DESC" }
          ]
        }
      }
    },
    {
      "name": "5. GET /books?min_price=500&max_price=1000 - Price Range",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?min_price=500&max_price=1000",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            { "key": "min_price", "value": "500" },
            { "key": "max_price", "value": "1000" }
          ]
        }
      }
    },
    {
      "name": "6. GET /books?limit=3&offset=3 - Pagination",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?limit=3&offset=3",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            { "key": "limit", "value": "3" },
            { "key": "offset", "value": "3" }
          ]
        }
      }
    },
    {
      "name": "7. GET /books/:bookId - Single Book (200 OK)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/1",
          "host": ["{{baseUrl}}"],
          "path": ["books", "1"]
        }
      }
    },
    {
      "name": "8. GET /books/999 - Non-existent Book (404 Not Found)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/999",
          "host": ["{{baseUrl}}"],
          "path": ["books", "999"]
        }
      }
    },
    {
      "name": "9. POST /books - Valid Book (201 Created)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Designing Data-Intensive Applications\",\n  \"author\": \"Martin Kleppmann\",\n  \"price\": 1450,\n  \"pages\": 616\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        }
      }
    },
    {
      "name": "10. POST /books - Missing Title (400 Bad Request)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"author\": \"Robert C. Martin\",\n  \"price\": 650,\n  \"pages\": 464\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        }
      }
    },
    {
      "name": "11. POST /books - Non-numeric Price (400 Bad Request)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Architecture\",\n  \"author\": \"Robert C. Martin\",\n  \"price\": \"five-hundred\",\n  \"pages\": 432\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        }
      }
    },
    {
      "name": "12. PUT /books/1 - Update Book (200 OK)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Atomic Habits (Hardcover Edition)\",\n  \"author\": \"James Clear\",\n  \"price\": 599,\n  \"pages\": 320\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books/1",
          "host": ["{{baseUrl}}"],
          "path": ["books", "1"]
        }
      }
    },
    {
      "name": "13. PUT /books/999 - Update Non-existent Book (404 Not Found)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Ghost Book\",\n  \"author\": \"Anonymous\",\n  \"price\": 999,\n  \"pages\": 100\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books/999",
          "host": ["{{baseUrl}}"],
          "path": ["books", "999"]
        }
      }
    },
    {
      "name": "14. DELETE /books/11 - Delete Book (200 OK)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/11",
          "host": ["{{baseUrl}}"],
          "path": ["books", "11"]
        }
      }
    },
    {
      "name": "15. DELETE /books/999 - Delete Non-existent Book (404 Not Found)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/999",
          "host": ["{{baseUrl}}"],
          "path": ["books", "999"]
        }
      }
    }
  ]
}
